{
  "name": "banban-mobile",
  "version": "0.9.0",
  "private": true,
  "description": "伴办 · Android 原生封装（Capacitor + 本地通知）",
  "scripts": {
    "build:native": "esbuild native-src.js --bundle --format=iife --target=es2020 --minify --outfile=www/js/native.js",
    "sync": "npm run build:native && cap sync android",
    "build:apk": "cd android && gradlew.bat assembleRelease"
  },
  "keywords": [
    "todo",
    "calendar",
    "capacitor",
    "android"
  ],
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
